local shared=game.ReplicatedStorage.VesperShared
local imported=workspace:FindFirstChild("shell-fractures") assert(imported,"Missing import")
for _,r in manifest do local part=imported:FindFirstChild(r.name,true) assert(part and part:IsA("MeshPart") and part.MeshId:match("rbxassetid://"),r.name) end
assert(not shared:FindFirstChild("FractureLibrary"),"Already installed")
local library=Instance.new("Folder") library.Name="FractureLibrary" library.Parent=shared
local ids={}
for i,r in manifest do
 local whole=shared.EggAssetPreload[r.template]
 local folder=library:FindFirstChild(r.template)
 if not folder then folder=Instance.new("Folder") folder.Name=r.template folder.Parent=library end
 local part=imported:FindFirstChild(r.name,true):Clone()
 for _,child in part:GetChildren() do child:Destroy() end
 part.Size=Vector3.new(unpack(r.size))
 part.CFrame=CFrame.new(Vector3.new(unpack(r.center))+require(shared.ExcavationConfig).Geometry.Base)*CFrame.Angles(0,math.pi,0)
 part.PivotOffset=CFrame.identity part.Anchored=true part.CanCollide=false part.CanTouch=false part.CanQuery=false part.CastShadow=false
 part.Color=whole.Color part.Material=whole.Material part.Transparency=0
 local surface=whole:FindFirstChildOfClass("SurfaceAppearance") if surface then surface:Clone().Parent=part end
 part:SetAttribute("RelativeCFrame",whole.CFrame:ToObjectSpace(part.CFrame))
 local delta=part.Position-whole.Position
 local normal=(whole.Position-Vector3.new(0,38.2,0)).Unit
 delta-=normal*delta:Dot(normal)
 if delta.Magnitude<.001 then delta=Vector3.yAxis end
 part:SetAttribute("FractureDirection",whole.CFrame:VectorToObjectSpace(delta.Unit))
 part.Parent=folder ids[r.name]=part.MeshId
 if i%36==0 then task.wait() end
end
local sources=shared:FindFirstChild("AssetSources")
if sources and sources:IsA("StringValue") then sources.Value..="\nFractureLibrary: 216 original procedural Blender fracture meshes; source src/models/build_fractures.py and shell-fractures.blend. No third-party assets." end
imported:Destroy()
return ids
